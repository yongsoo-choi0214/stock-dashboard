# 키 이름만 기록. 실제 값은 .env 에 (gitignore 됨)

# FRED (미국 매크로) : https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ECOS (한국은행)    : https://ecos.bok.or.kr/api/#/AuthKeyApply
ECOS_API_KEY=

# KRX (data.krx.co.kr 회원가입) — pykrx 1.2+ 부터 로그인 필수.
# 지수 OHLCV 는 FinanceDataReader 로 대체 가능하나, 투자자별 수급(flows)은 이 계정이 있어야 한다.
KRX_ID=
KRX_PW=
